# ──────────────────────────────────────────────────────────────────────────────
# EventMate — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# ⚠️  NEVER commit a real .env file to version control.
#     This .env.example contains only placeholder values.
#
# In production, prefer a secrets manager over a plain .env file:
#   • Render  → Secret Files (Dashboard > Environment > Secret Files)
#   • AWS     → AWS Secrets Manager or SSM Parameter Store
#   • Azure   → Azure Key Vault
#   • GCP     → Secret Manager
#   • Local   → keep .env out of git (already in .gitignore)
# ──────────────────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/eventmate

# Auth
JWT_SECRET=your_jwt_secret_here

# CORS — set to your frontend URL in production
CLIENT_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP) — leave blank to use Ethereal test account in dev
# In production, store these via your hosting provider's secrets manager
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
EMAIL_FROM="EventMate Admin" <admin@eventmate.io>
